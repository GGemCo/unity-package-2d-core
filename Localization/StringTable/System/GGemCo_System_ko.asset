      m_Items: []
  - m_Id: 403011342338
    m_Localized: "\uCFE8\uD0C0\uC784 \uC911\uC5D0\uB294 \uBC14\uAFC0 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
